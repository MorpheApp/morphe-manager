<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Older compat splash screens draw only the first frame, which is empty in this animation -->
    <style name="Theme.MorpheManager" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_morphe_splash</item>
        <item name="windowSplashScreenAnimationDuration">750</item>
        <item name="postSplashScreenTheme">@style/Theme.AppCompat.NoActionBar</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
